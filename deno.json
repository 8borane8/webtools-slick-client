{
	"name": "@webtools/slick-client",
	"exports": "./src/mod.ts",
	"version": "0.4.0",
	"license": "MIT",

	"lock": false,
	"imports": {
		"@webtools/expressapi": "jsr:@webtools/expressapi@0",
		"@std/assert": "jsr:@std/assert@^1.0.0",
		"happy-dom": "npm:happy-dom@^20.14.5"
